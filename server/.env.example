# Hearth API — example configuration.
#
# Filling these in is NOT enough to make payments work: the demo fuses in
# server/mpesa.js (FUSE_TOKEN, FUSE_RESULT) and server/auth.js (FUSE_IDENTITY)
# short-circuit the happy path regardless. Turn those off first.

PORT=8787

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://example.com/api/mpesa/callback
